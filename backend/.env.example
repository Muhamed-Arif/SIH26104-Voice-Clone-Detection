# SIH26104 integrated local/demo configuration
PROJECT_NAME="SIH26104 Voice Cloning Detection Backend"
ENVIRONMENT=development
DEBUG=True
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8000

# Zero-config local default. For MySQL, replace with:
# mysql+aiomysql://root:YOUR_PASSWORD@localhost:3306/voice_shield
DATABASE_URL=sqlite+aiosqlite:///./voice_shield.db

SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=120

# Real M1 service — mock is disabled in integrated mode.
ML_SERVICE_URL=http://127.0.0.1:8001/predict
MOCK_ML_SERVICE=False
ML_REQUEST_TIMEOUT_SECONDS=8.0

RISK_THRESHOLD_LOW=30.0
RISK_THRESHOLD_HIGH=70.0
CONFIDENCE_THRESHOLD=0.65
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
