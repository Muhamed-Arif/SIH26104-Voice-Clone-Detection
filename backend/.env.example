# Environment configuration for SIH26104 Backend
PROJECT_NAME="SIH26104 Voice Cloning Detection Backend"
ENVIRONMENT=development
DEBUG=True
API_V1_STR="/api/v1"

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL in production, SQLite fallback in dev/test)
# Postgres: postgresql+asyncpg://postgres:postgres@localhost:5432/sih_voice_db
# SQLite: sqlite+aiosqlite:///./test.db
DATABASE_URL=sqlite+aiosqlite:///./voice_cloning.db

# Security & Authentication
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# External ML Service Integration (Member 1)
ML_SERVICE_URL=http://localhost:8001/predict
MOCK_ML_SERVICE=True
ML_REQUEST_TIMEOUT_SECONDS=5.0

# Risk Engine Thresholds
RISK_THRESHOLD_LOW=30.0
RISK_THRESHOLD_HIGH=70.0
CONFIDENCE_THRESHOLD=0.65

# CORS Settings (Comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
